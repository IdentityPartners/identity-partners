---
/**
 * Randomly select an image from the sunrise folder.
 * import.meta.glob eagerly loads all files at build time.
 */

const sunriseImages = import.meta.glob('../assets/images/sunrise/*', { eager: true });

// Convert the object of modules into an array
const sunriseFiles = Object.values(sunriseImages);

// Pick one at random
const sunrise = sunriseFiles[Math.floor(Math.random() * sunriseFiles.length)];
---

<section class="gradient-block">
  <div class="inner">
    <h2>Clarity Emerges Gradually</h2>
    <p>Identity work isn’t a switch — it’s a gradient.</p>

    <!-- Use the actual Astro-generated URL -->
    <img src={sunrise.default.src} alt="Sunrise" class="sunrise-img" />
  </div>
</section>

<style>
  .gradient-block {
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .sunrise-img {
    max-width: 100%;
    border-radius: 12px;
    margin-top: 2rem;
  }
</style>

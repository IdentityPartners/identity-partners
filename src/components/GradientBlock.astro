---
import { glob } from 'astro/loaders';

const sunriseImages = await glob({
  pattern: 'public/assets/images/sunrise/*',
});
const sunrise = sunriseImages[Math.floor(Math.random() * sunriseImages.length)];
---

<section class="gradient-block">
  <div class="inner">
    <h2>Clarity Emerges Gradually</h2>
    <p>Identity work isn’t a switch — it’s a gradient.</p>
    <img src={sunrise.src} alt="Sunrise" class="sunrise-img" />
  </div>
</section>

<style>
  .gradient-block {
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .sunrise-img {
    max-width: 100%;
    border-radius: 12px;
    margin-top: 2rem;
  }
</style>



---
import { glob } from 'astro/loaders';

// Random identity image
const identityImages = await glob({
  pattern: '/assets/images/identity/*',
});
const identity = identityImages[Math.floor(Math.random() * identityImages.length)];
---

<section class="hero-block">
  <div class="inner">
    <div class="text">
      <h1>Identity Work That Actually Works</h1>
      <p>
        You don’t need to perform here. You don’t need to impress anyone.  
        You don’t need to pretend you’re fine.  
        You just need to show up — and we’ll meet you where you are.
      </p>
    </div>

    <div class="visual">
      <img src={identity.src} alt="Identity" />
    </div>
  </div>
</section>

<style>
  .hero-block {
    background: var(--surface);
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .text {
    flex: 1;
  }

  .text h1 {
    color: var(--accent);
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .text p {
    color: var(--foreground);
    line-height: 1.6;
    font-size: 1.2rem;
  }

  .visual {
    flex: 1;
    text-align: right;
  }

  .visual img {
    max-width: 100%;
    border-radius: 12px;
  }

  @media (max-width: 800px) {
    .inner {
      flex-direction: column;
      text-align: center;
    }
    .visual {
      text-align: center;
    }
  }
</style>

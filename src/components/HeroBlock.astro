---
/**
 * Randomly select an image from the identity folder.
 * import.meta.glob eagerly loads all files at build time.
 */

const identityImages = import.meta.glob('../assets/images/identity/*', { eager: true });

// Convert the object of modules into an array
const identityFiles = Object.values(identityImages);

// Pick one at random
const identity = identityFiles[Math.floor(Math.random() * identityFiles.length)];
---

<section class="hero-block">
  <div class="inner">
    <div class="text">
      <h1>Identity work that works for you</h1>
      <p>
        You don’t need to perform here. You don’t need to impress anyone.  
        You don’t need to pretend you’re "fine".  
        You just need to show up; we’ll meet you where you are.
      </p>
    </div>

    <div class="visual">
      <img src={identity.default.src} alt="Identity" />
    </div>
  </div>
</section>

<style>
  .hero-block {
    background: var(--surface);
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .text {
    flex: 1;
  }

  .text h1 {
    color: var(--accent);
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .text p {
    color: var(--foreground);
    line-height: 1.6;
    font-size: 1.2rem;
  }

  .visual {
    flex: 1;
    text-align: right;
  }

  .visual img {
    max-width: 100%;
    border-radius: 12px;
  }

  @media (max-width: 800px) {
    .inner {
      flex-direction: column;
      text-align: center;
    }
    .visual {
      text-align: center;
    }
  }
</style>

---
/**
 * Randomly select images from each folder.
 * import.meta.glob eagerly loads all files at build time.
 */

// Identity (small)
const identityImages = import.meta.glob('../assets/images/identity/*', { eager: true });
const identityFiles = Object.values(identityImages);
const identity = identityFiles[Math.floor(Math.random() * identityFiles.length)];

// Partnering (small)
const partneringImages = import.meta.glob('../assets/images/partnering/*', { eager: true });
const partneringFiles = Object.values(partneringImages);
const partnering = partneringFiles[Math.floor(Math.random() * partneringFiles.length)];

// Sunrise (background)
const sunriseImages = import.meta.glob('../assets/images/sunrise/*', { eager: true });
const sunriseFiles = Object.values(sunriseImages);
const sunrise = sunriseFiles[Math.floor(Math.random() * sunriseFiles.length)];

// Landscape (background)
const landscapeImages = import.meta.glob('../assets/images/landscape/*', { eager: true });
const landscapeFiles = Object.values(landscapeImages);
const landscape = landscapeFiles[Math.floor(Math.random() * landscapeFiles.length)];
---

<section class="identity-showcase">
  <div class="inner">

    <div class="small-images">
      <img src={identity.default.src} alt="Identity" class="small-img" />
      <img src={partnering.default.src} alt="Partnering" class="small-img" />
    </div>

    <div class="background sunrise-bg">
      <h2>Emergence</h2>
      <p>Identity work begins quietly — like sunrise.</p>
    </div>

    <div class="background landscape-bg">
      <h2>Grounding</h2>
      <p>Identity work needs places to land, pause, breathe.</p>
    </div>

  </div>
</section>

<style>
  .identity-showcase {
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .small-images {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .small-img {
    width: 180px;
    height: auto;
    border-radius: 8px;
    border: 2px solid var(--border);
  }

  .background {
    padding: 3rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    color: var(--foreground);
  }

  .sunrise-bg {
    background-image: url({sunrise.default.src});
    background-size: cover;
    background-position: center;
  }

  .landscape-bg {
    background-image: url({landscape.default.src});
    background-size: cover;
    background-position: center;
  }

  .background h2 {
    color: var(--accent);
    margin-bottom: 1rem;
  }
</style>

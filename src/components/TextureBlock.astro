---
import { glob } from 'astro/loaders';

const landscapeImages = await glob({
  pattern: 'public/assets/images/landscape/*',
});
const landscape = landscapeImages[Math.floor(Math.random() * landscapeImages.length)];
---

<section class="texture-block" style={`background-image: url(${landscape.src});`}>
  <div class="overlay">
    <h2>Grounding Matters</h2>
    <p>Identity work needs places to land, pause, breathe.</p>
  </div>
</section>

<style>
  .texture-block {
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
    background-size: cover;
    background-position: center;
  }

  .overlay {
    background: rgba(247, 243, 233, 0.85);
    padding: 3rem;
    border-radius: 12px;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
</style>

---
/**
 * Randomly select an image from the textures folder.
 * import.meta.glob eagerly loads all files at build time.
 */

const textureImages = import.meta.glob('../assets/images/textures/*', { eager: true });

// Convert the object of modules into an array
const textureFiles = Object.values(textureImages);

// Pick one at random
const textureBg = textureFiles[Math.floor(Math.random() * textureFiles.length)];
---

<section class="texture-block" style={`background-image: url(${textureBg.default.src});`}>
  <div class="overlay">
    <h2>Grounding Matters</h2>
    <p>Identity work needs places to land, pause, breathe.</p>
  </div>
</section>

<style>
  .texture-block {
    padding: 4rem 1.5rem;
    border-bottom: 2px solid var(--border);
    background-size: cover;
    background-position: center;
  }

  .overlay {
    background: rgba(247, 243, 233, 0.85);
    padding: 3rem;
    border-radius: 12px;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
</style>

---
/**
 * Randomly select an image from the partnering folder.
 * import.meta.glob eagerly loads all files at build time.
 */

const partneringImages = import.meta.glob('../assets/images/partnering/*', { eager: true });

// Convert the object of modules into an array
const partneringFiles = Object.values(partneringImages);

// Pick one at random
const partnering = partneringFiles[Math.floor(Math.random() * partneringFiles.length)];
---

<section class="right-rect">
  <div class="visual">
    <img src={partnering.default.src} alt="Partnering" />
  </div>

  <div class="content">
    <h2>Work That Happens With You, Not At You</h2>
    <p>
      Identity work is relational. We walk with you, not ahead of you, not behind you.
      The process is collaborative, structured, and grounded in real human connection.
    </p>
  </div>
</section>

<style>
  .right-rect {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 4rem 1.5rem;
    background: var(--surface);
    border-bottom: 2px solid var(--border);
  }

  .visual {
    flex: 1;
    text-align: left;
  }

  .visual img {
    max-width: 100%;
    border-radius: 8px;
  }

  .content {
    flex: 1;
  }

  .content h2 {
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .content p {
    color: var(--foreground);
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .right-rect {
      flex-direction: column;
      text-align: center;
    }
    .visual {
      text-align: center;
    }
  }
</style>

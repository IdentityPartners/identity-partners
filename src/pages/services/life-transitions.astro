---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Life Transitions">
  <h1>Life Transitions</h1>

  <p>
    Life transitions are moments where identity shifts, expands, contracts, or
    needs recalibration. These packages offer structured support through
    significant changes.
  </p>

  <ul>
    <li>Career change</li>
    <li>Return to education</li>
    <li>Relocation</li>
    <li>ND late diagnosis</li>
    <li>Familial estrangement</li>
    <li>Physical assault</li>
    <li>Relationship breakdown</li>
    <li>Mental breakdown</li>
    <li>Bereavement</li>
  </ul>
</BaseLayout>
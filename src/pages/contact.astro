---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact Us">
  <section style="padding: 4rem 1.5rem; max-width: 900px; margin: 0 auto;">
    <h1 style="color: var(--accent);">Contact Us</h1>
    <p style="line-height: 1.6; color: var(--foreground);">
      Send us a message using the form below.
    </p>

    <form action="https://formspree.io/f/your-form-id" method="POST" style="margin-top: 2rem;">
      <label style="display:block; margin-bottom:1rem;">
        Your Name<br />
        <input type="text" name="name" required style="width:100%; padding:0.75rem; margin-top:0.5rem;" />
      </label>

      <label style="display:block; margin-bottom:1rem;">
        Your Email<br />
        <input type="email" name="email" required style="width:100%; padding:0.75rem; margin-top:0.5rem;" />
      </label>

      <label style="display:block; margin-bottom:1rem;">
        What is this regarding?<br />
        <select name="topic" required style="width:100%; padding:0.75rem; margin-top:0.5rem;">
          <option value="one-off">One-Off Session</option>
          <option value="transition">Life Transition Work</option>
          <option value="ileap">ILEAP Programme</option>
          <option value="iamsuper">IAMSUPER Programme</option>
          <option value="general">General Enquiry</option>
        </select>
      </label>

      <label style="display:block; margin-bottom:1rem;">
        Your Message<br />
        <textarea name="message" required rows="6" style="width:100%; padding:0.75rem; margin-top:0.5rem;"></textarea>
      </label>

      <button type="submit" style="
        background: var(--accent);
        color: var(--surface);
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
      ">
        Send Message
      </button>
    </form>
  </section>
</BaseLayout>

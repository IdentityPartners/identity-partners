---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Substack">
  <section style="padding: 4rem 1.5rem; max-width: 900px; margin: 0 auto;">
    <h1 style="color: var(--accent);">Identity Partners on Substack</h1>

    <p style="line-height: 1.6; color: var(--foreground); margin-top: 1.5rem;">
      Our writing, essays, reflections, and long-form thinking live on Substack.
      You can read, subscribe, and follow our work directly there.
    </p>

    <p style="margin-top: 2rem;">
      <a href="https://identitypartners.substack.com" target="_blank"
         style="background: var(--accent); color: var(--surface); padding: 0.75rem 1.5rem;
                border-radius: 8px; font-weight: 600; text-decoration: none;">
        Visit our Substack
      </a>
    </p>

    <p style="margin-top: 2rem; line-height: 1.6;">
      Substack does not allow embedding without client-side scripts, and Astro prerendering
      does not support DOMParser or browser-only APIs.  
      So this page links directly to our Substack instead of embedding it.
    </p>
  </section>
</BaseLayout>

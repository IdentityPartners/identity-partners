---
/**
 * Random sunrise + texture backgrounds using import.meta.glob
 * (Cloudflare‑safe, Astro‑safe, no .src errors)
 */

const sunriseImages = import.meta.glob('../assets/images/sunrise/*', { eager: true });
const sunriseFiles = Object.values(sunriseImages);
const sunriseBg = sunriseFiles[Math.floor(Math.random() * sunriseFiles.length)];

const textureImages = import.meta.glob('../assets/images/textures/*', { eager: true });
const textureFiles = Object.values(textureImages);
const textureBg = textureFiles[Math.floor(Math.random() * textureFiles.length)];

const title = Astro.props.title ?? "Identity Partners";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <style>
      :root {
        --background: #f7f3e9;
        --surface: #f0e9e0;
        --border: #7a4254;
        --accent: #0f3b3a;
        --foreground: #5c2d3f;
      }

      body {
        margin: 0;
        background: var(--background);
        font-family: system-ui, sans-serif;
        color: var(--foreground);
      }

      header {
        background: var(--surface);
        border-bottom: 2px solid var(--border);
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      header img {
        height: 60px;
      }

      nav a {
        margin-left: 1.5rem;
        text-decoration: none;
        color: var(--accent);
        font-weight: 600;
      }

      .hero {
        background: url({sunriseBg.default.src}) center/cover no-repeat;
        padding: 6rem 1.5rem 4rem;
        text-align: center;
        border-bottom: 2px solid var(--border);
      }

      .hero-logo {
        background: var(--surface);
        padding: 2rem;
        border-radius: 12px;
        display: inline-block;
        margin-bottom: 2rem;
      }

      .hero-logo img {
        height: 100px;
      }

      main {
        padding-bottom: 4rem;
      }

      footer {
        background-image: url({textureBg.default.src});
        background-size: cover;
        background-position: center;
        padding: 3rem 1.5rem;
        border-top: 2px solid var(--border);
        text-align: center;
      }

      footer img {
        height: 60px;
        margin-bottom: 1rem;
      }

      .footer-contact {
        background: rgba(247, 243, 233, 0.85);
        padding: 2rem;
        border-radius: 12px;
        max-width: 900px;
        margin: 2rem auto;
      }

      .footer-contact h3 {
        margin-top: 0;
        color: var(--accent);
      }

      .footer-contact a {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
      }

      .social-links {
        margin-top: 1rem;
        line-height: 1.8;
      }
    </style>
  </head>

  <body>

    <!-- HEADER -->
    <header>
      <img src="/assets/logos/logo-rect-left.png" alt="Identity Partners logo" />
      <nav>
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/about/identity-partners">About</a>
        <a href="/resources">Resources</a>
        <a href="/support">Support</a>
        <a href="/community">Community</a>
        <a href="/blog">Blog</a>
        <a href="/substack">Substack</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-logo">
        <img src="/assets/logos/logo-hero-tag.png" alt="Identity Partners hero logo" />
      </div>
    </section>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer>
      <img src="/assets/logos/logo-rect-right.png" alt="Identity Partners footer logo" />
      <p>Identity Partners — Relational Identity Practice</p>

      <div class="footer-contact">
        <h3>Contact Us</h3>
        <p>
          <a href="mailto:simon@identitypartners.uk">simon@identitypartners.uk</a><br />
          <a href="mailto:olivia@identitypartners.uk">olivia@identitypartners.uk</a>
        </p>

        <div class="social-links">
          <a href="https://x.com/IdentityPtnrs" target="_blank">X (Twitter): @IdentityPtnrs</a><br />
          <a href="https://www.facebook.com/identitypartners" target="_blank">Facebook: @identitypartners</a><br />
          <a href="https://www.instagram.com/identitypartners" target="_blank">Instagram: @identitypartners</a><br />
          <a href="https://www.threads.net/@identitypartners" target="_blank">Threads: @identitypartners</a><br />
          <a href="https://bsky.app/profile/identitypartners.bsky.social" target="_blank">Bluesky: @identitypartners.bsky.social</a><br />
          <a href="https://www.linkedin.com/company/identitypartners-uk/" target="_blank">LinkedIn</a>
        </div>
      </div>
    </footer>

  </body>
</html>
